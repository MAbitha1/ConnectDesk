PORT=5000
NODE_ENV=development
# Allowed frontend origin(s) in production (e.g. https://your-app.vercel.app or comma-separated)
CLIENT_URL=http://localhost:5173
# MongoDB Atlas Connection String Template (Do not expose real credentials here)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/connectdesk?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_key_here

